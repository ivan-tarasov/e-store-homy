{
    "name": "homy/e-store-demo",
    "description": "Portfolio demo of a small e-commerce storefront. File-based storage, PSR-4, FastRoute.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nikic/fast-route": "^1.3",
        "monolog/monolog": "^3.5",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public public/index.php"
    }
}
